# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Database connection (local dev: localhost, Docker: postgres)
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=postgres

# Backend
CORS_ORIGIN=*

# Frontend — baked at build time, requires rebuild to change
# local dev: http://localhost:3001 | Docker: /api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SHOW_ID=false

# Protomaps — get free key at protomaps.com
NEXT_PUBLIC_PROTOMAPS_KEY=

# Maptiler — optional, enables terrain hillshading, get free key at maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=

# Tile mode — true = PMTiles direct (no tileserver), false = tileserver
NEXT_PUBLIC_USE_PMTILES=false

# Tileserver base URL (used when USE_PMTILES=false). Leave EMPTY to serve tiles same-origin from
# the current domain's /tiles at runtime (one build works for multiple public domains). Set only
# to override with an explicit absolute URL (e.g. a dedicated tiles CDN).
NEXT_PUBLIC_TILES_BASE_URL=

# Nginx
NGINX_SERVER_NAME=localhost

# Per-host landing: visitors to YOM_HOST land on /forecast/yom, PING_HOST on /forecast/ping.
# Set these to the client-provided domains (bare hostnames, no scheme/path). Must be non-empty.
YOM_HOST=yom.localhost
PING_HOST=ping.localhost
